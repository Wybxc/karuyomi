+    private int readCodePointHex() {
+        nextIndex(); // opening brace
+        int value = 0;
+        boolean digitSeen = false;
+        while (index < pattern.length - 2) {
+            char c = pattern[nextIndex()];
+            if (c == '}' && digitSeen) {
+                return value;
+            }
+            int digit = c >= '0' && c <= '9' ? c - '0'
+                    : c >= 'a' && c <= 'f' ? c - 'a' + 10
+                    : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+            if (digit < 0 || value > (Character.MAX_CODE_POINT - digit) / 16) {
+                break;
+            }
+            value = value * 16 + digit;
+            digitSeen = true;
+        }
+        throw new TPatternSyntaxException("Illegal hexadecimal escape sequence", orig, index);
+    }
