{
  "name": "karuyomi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @karuyomi/api dev",
    "dev:flutter": "node scripts/flutter.ts run",
    "generate": "node scripts/generate-protocol.ts",
    "generate:check": "node scripts/generate-protocol.ts --check",
    "protocol:setup": "node scripts/generate-protocol.ts --setup",
    "test:protocol": "node --test tools/protocol/golden.test.ts",
    "format": "node scripts/format.ts --write",
    "format:check": "node scripts/format.ts --check",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tools && pnpm typecheck:bridges && pnpm typecheck:image-codecs",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck:bridges": "tsc -p runtime/teavm/bridge/tsconfig.json && tsc -p packages/runtime-host/test/tsconfig.bridge-browser.json",
    "test": "vitest run",
    "check": "pnpm generate:check && pnpm format:check:portable && pnpm typecheck && pnpm check:dependencies && pnpm test && pnpm test:protocol && pnpm test:registration && pnpm test:extensions && pnpm test:extension-build && pnpm test:extension-integrity && pnpm test:extension-assets && pnpm test:teavm-patches && pnpm test:reader-assets && pnpm test:cloudflare-probe && pnpm test:http-bridge && pnpm test:image-codecs",
    "test:registration": "node --test tools/extensions/registration.test.ts tools/extensions/network-policies.test.ts",
    "test:extensions": "node --test tools/extensions/catalog.test.ts tools/extensions/assets.test.ts tools/extensions/pipeline.test.ts tools/extensions/runner.test.ts",
    "test:extension-build": "node --test tools/extensions/builder.test.ts tools/teavm/runtime.test.ts tools/teavm/build.test.ts",
    "test:extension-integrity": "node --test tools/extensions/verify-build.test.ts",
    "test:extension-assets": "node --test tools/extensions/assemble-assets.test.ts",
    "test:teavm-patches": "node --test tools/teavm/upstream-sources.test.ts",
    "test:http-bridge": "node apps/api/test/http-bridge-workerd-probe.ts",
    "flutter:setup": "node scripts/flutter.ts setup",
    "flutter:check": "node scripts/flutter.ts check",
    "build": "pnpm --filter @karuyomi/runtime-host build && node scripts/assemble-native-assets.ts && node scripts/flutter.ts build && node scripts/assemble-assets.ts && pnpm --filter @karuyomi/api build",
    "db:generate": "pnpm --filter @karuyomi/api db:generate",
    "db:migrate:local": "pnpm --filter @karuyomi/api db:migrate:local",
    "teavm:build": "node scripts/build-extension.ts",
    "teavm:check": "node tools/teavm/check-dto.ts",
    "teavm:prepare": "node scripts/prepare-runtime.ts",
    "hooks:install": "prek install",
    "format:check:portable": "node scripts/format.ts --check --portable",
    "hooks:check": "prek run --all-files --show-diff-on-failure",
    "check:dependencies": "depcruise --config .dependency-cruiser.json scripts tools packages apps/api/src apps/api/test runtime/teavm/bridge runtime/image-codec",
    "test:cloudflare-probe": "node --test tools/cloudflare/*.test.ts",
    "test:reader-assets": "node --test tools/reader/database-assets.test.ts",
    "image-codecs:prepare": "node scripts/prepare-image-codecs.ts",
    "test:image-codecs": "node --test tools/images/*.test.ts runtime/image-codec/*.test.ts",
    "typecheck:image-codecs": "tsc -p runtime/image-codec/tsconfig.json && tsc -p runtime/image-codec/tsconfig.worker.json",
    "image-codecs:build": "node scripts/build-image-codecs.ts",
    "image-codecs:check": "node scripts/check-image-codecs.ts",
    "image-codecs:prepare-artifacts": "node scripts/prepare-image-codec-artifacts.ts",
    "image-codecs:package": "node scripts/package-image-codec-artifacts.ts",
    "image-codecs:check-worker": "node scripts/check-image-codec-worker.ts",
    "image-codecs:check-owners": "node scripts/check-image-owners.ts"
  },
  "devDependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@j178/prek": "0.5.9",
    "@karuyomi/protocol": "workspace:*",
    "@prettier/plugin-xml": "3.4.2",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/write-file-atomic": "4.0.3",
    "@types/yauzl": "3.4.0",
    "bidi-js": "1.0.3",
    "dependency-cruiser": "18.7.1",
    "diff": "9.0.0",
    "esbuild": "0.28.2",
    "execa": "10.2.1",
    "fflate": "0.8.3",
    "get-stream": "9.0.1",
    "idb": "8.0.4",
    "image-dimensions": "2.6.0",
    "is-plain-obj": "4.1.0",
    "java-parser": "3.0.1",
    "jose": "6.2.15",
    "json-stable-stringify": "1.3.0",
    "linebreak": "1.1.0",
    "miniflare": "5.20261101.0-beta",
    "p-limit": "7.3.3",
    "prettier": "3.9.10",
    "proper-lockfile": "4.1.2",
    "sharp": "0.35.5",
    "sirv": "3.0.2",
    "sql-formatter": "15.9.0",
    "tar": "7.5.22",
    "typescript": "6.0.3",
    "undici": "7.30.1",
    "vitest": "4.1.12",
    "write-file-atomic": "8.0.0",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  }
}
